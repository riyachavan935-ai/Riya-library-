<script>
let books=[
{id:'BK1001',title:'Java Programming',status:'Available'},
{id:'BK1002',title:'Python Basics',status:'Available'}
];
let counter=1003;
function render(){
document.getElementById('tbody').innerHTML=books.map(b=>`<tr><td>${b.id}</td><td>${b.title}</td><td style="color:${b.status=='Available'?'green':'red'}"><b>${b.status}</b></td></tr>`).join('');
}
function addBook(){
let t=document.getElementById('title').value;
let a=document.getElementById('author').value;
if(!t){alert('Book Title likho!');return;}
let id='BK'+counter++;
books.push({id,title:t,status:'Available'});
render();
let out=document.getElementById('output');
out.innerHTML+=`<br>> ✅ OUTPUT AAYA - BOOK ADDED!<br>> Book ID: ${id}<br>> Title: ${t}<br>> Author: ${a}<br>> Status: Available<br>> System.out.println("BOOK ADDED SUCCESS");<br>> -------------------------------`;
out.scrollTop=out.scrollHeight;
document.getElementById('title').value='';
}
function issueBook(){
let s=document.getElementById('student').value||'Riya Chavan 3121';
let b=books.find(x=>x.status=='Available');
if(!b){alert('Koi book available nahi! Pehle Add karo');return;}
b.status='Issued';
render();
document.getElementById('output').innerHTML+=`<br>> 📕 BOOK ISSUED!<br>> ${b.id} - ${b.title}<br>> Issued To: ${s}<br>> Status: Issued<br>> -------------------------------`;
}
function returnBook(){
let b=books.find(x=>x.status=='Issued');
if(!b){alert('Koi Issued book nahi hai!');return;}
b.status='Available';
render();
document.getElementById('output').innerHTML+=`<br>> 📗 BOOK RETURNED!<br>> ${b.id} - Available Again<br>> -------------------------------`;
}
render();
</script>
